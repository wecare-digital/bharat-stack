{
  "mcpServers": {
    "google-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp@0.5.3"
      ],
      "disabled": false,
      "autoApprove": []
    },
    "razorpay": {
      "url": "https://mcp.razorpay.com/mcp",
      "headers": {
        "Authorization": "Basic ${RAZORPAY_MERCHANT_TOKEN}"
      },
      "disabled": true,
      "autoApprove": [],
      "disabledTools": [
        "capture_payment",
        "update_payment",
        "initiate_payment",
        "resend_otp",
        "submit_otp",
        "create_payment_link",
        "create_payment_link_upi",
        "send_payment_link",
        "update_payment_link",
        "create_order",
        "update_order",
        "create_refund",
        "update_refund",
        "create_qr_code",
        "close_qr_code",
        "create_instant_settlement",
        "revoke_token",
        "create_registration_link",
        "integrate_razorpay_checkout"
      ]
    }
  }
}
