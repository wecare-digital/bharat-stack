{
  "jobs": [
    {
      "functionLocation": "/backend/pinger.js",
      "functionName": "pingAll",
      "description": "Health check — ping all SEO, Store API, and AWS endpoints every hour",
      "executionConfig": {
        "cronExpression": "0 * * * *",
        "dateInTimezone": "Asia/Kolkata"
      }
    }
  ]
}
