{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": { "INTAKE_FORM": ["CONFIRM"], "CONFIRM": [] },
  "screens": [
    {
      "id": "INTAKE_FORM",
      "title": "Enterprise Assist",
      "data": {
        "priorities": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [ { "id": "normal", "title": "Normal" }, { "id": "high", "title": "High" }, { "id": "urgent", "title": "Urgent" } ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Enterprise Assist" },
          { "type": "TextBody", "text": "Corporate, B2B, and bulk enquiries. Tell us what you need." },
          { "type": "TextInput", "name": "account_name", "label": "Company Name", "required": true, "input-type": "text", "max-chars": 60 },
          { "type": "TextInput", "name": "contact_name", "label": "Your Name", "required": true, "input-type": "text", "max-chars": 40 },
          { "type": "TextInput", "name": "contact_email", "label": "Email", "required": false, "input-type": "email", "max-chars": 60 },
          { "type": "TextInput", "name": "subject", "label": "Subject", "required": true, "input-type": "text", "max-chars": 80, "helper-text": "Brief summary of your enquiry" },
          { "type": "TextArea", "name": "description", "label": "Description", "required": true, "max-length": 600, "helper-text": "Share details about your requirement." },
          { "type": "Dropdown", "name": "priority", "label": "Priority", "required": true, "data-source": "${data.priorities}" },
          { "type": "Footer", "label": "Submit Enquiry", "on-click-action": { "name": "data_exchange", "payload": { "account_name": "${form.account_name}", "contact_name": "${form.contact_name}", "contact_email": "${form.contact_email}", "subject": "${form.subject}", "description": "${form.description}", "priority": "${form.priority}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Enquiry Submitted",
      "terminal": true,
      "data": {
        "case_id": { "type": "string", "__example__": "WD-ENT-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Your enterprise enquiry has been submitted. Our team will reach out shortly." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Enquiry Submitted" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Case Reference" },
          { "type": "TextSubheading", "text": "${data.case_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}