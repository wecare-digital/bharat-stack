{
    "version": "7.3",
    "routing_model": {
        "SUMMARY": [
            "ADDRESS"
        ],
        "ADDRESS": [
            "DETAILS"
        ],
        "DETAILS": [
            "SUCCESS"
        ],
        "SUCCESS": []
    },
    "screens": [
        {
            "id": "SUMMARY",
            "title": "Payment Received",
            "data": {
                "request_id": {
                    "type": "string",
                    "__example__": "WD-SR-A1B2C3D4"
                },
                "order_number": {
                    "type": "string",
                    "__example__": "WD-PAY-12345678"
                },
                "product": {
                    "type": "string",
                    "__example__": "Service Sample"
                },
                "amount": {
                    "type": "string",
                    "__example__": "\u20b91.00"
                },
                "cust_name": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_line": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_city": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_state": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_pin": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_landmark": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Payment received \u2705"
                    },
                    {
                        "type": "TextBody",
                        "text": "Thank you! Here is your request summary. Tap Continue to complete your details."
                    },
                    {
                        "type": "TextCaption",
                        "text": "Request ID",
                        "font-weight": "bold"
                    },
                    {
                        "type": "TextSubheading",
                        "text": "${data.request_id}"
                    },
                    {
                        "type": "TextCaption",
                        "text": "Service",
                        "font-weight": "bold"
                    },
                    {
                        "type": "TextBody",
                        "text": "${data.product}"
                    },
                    {
                        "type": "TextCaption",
                        "text": "Amount Paid",
                        "font-weight": "bold"
                    },
                    {
                        "type": "TextBody",
                        "text": "${data.amount}"
                    },
                    {
                        "type": "Footer",
                        "label": "Continue \u2192",
                        "on-click-action": {
                            "name": "navigate",
                            "next": {
                                "type": "screen",
                                "name": "ADDRESS"
                            },
                            "payload": {
                                "request_id": "${data.request_id}",
                                "order_number": "${data.order_number}",
                                "product": "${data.product}",
                                "amount": "${data.amount}",
                                "cust_name": "${data.cust_name}",
                                "addr_line": "${data.addr_line}",
                                "addr_city": "${data.addr_city}",
                                "addr_state": "${data.addr_state}",
                                "addr_pin": "${data.addr_pin}",
                                "addr_landmark": "${data.addr_landmark}"
                            }
                        }
                    }
                ]
            }
        },
        {
            "id": "ADDRESS",
            "title": "Delivery Address",
            "data": {
                "request_id": {
                    "type": "string",
                    "__example__": "WD-SR-A1B2C3D4"
                },
                "order_number": {
                    "type": "string",
                    "__example__": "WD-PAY-12345678"
                },
                "product": {
                    "type": "string",
                    "__example__": "Service Sample"
                },
                "amount": {
                    "type": "string",
                    "__example__": "\u20b91.00"
                },
                "cust_name": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_line": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_city": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_state": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_pin": {
                    "type": "string",
                    "__example__": ""
                },
                "addr_landmark": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextBody",
                        "text": "Confirm or update your delivery address."
                    },
                    {
                        "type": "Form",
                        "name": "address_form",
                        "init-values": {
                            "name": "${data.cust_name}",
                            "address": "${data.addr_line}",
                            "landmark": "${data.addr_landmark}",
                            "city": "${data.addr_city}",
                            "state": "${data.addr_state}",
                            "pin": "${data.addr_pin}"
                        },
                        "children": [
                            {
                                "type": "TextInput",
                                "name": "name",
                                "label": "Full name",
                                "required": true,
                                "input-type": "text"
                            },
                            {
                                "type": "TextInput",
                                "name": "address",
                                "label": "Address (house, street)",
                                "required": true,
                                "input-type": "text"
                            },
                            {
                                "type": "TextInput",
                                "name": "landmark",
                                "label": "Landmark / area",
                                "required": false,
                                "input-type": "text"
                            },
                            {
                                "type": "TextInput",
                                "name": "city",
                                "label": "City",
                                "required": true,
                                "input-type": "text"
                            },
                            {
                                "type": "TextInput",
                                "name": "state",
                                "label": "State",
                                "required": true,
                                "input-type": "text"
                            },
                            {
                                "type": "TextInput",
                                "name": "pin",
                                "label": "PIN code",
                                "required": true,
                                "input-type": "text"
                            },
                            {
                                "type": "Footer",
                                "label": "Continue \u2192",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "DETAILS"
                                    },
                                    "payload": {
                                        "request_id": "${data.request_id}",
                                        "order_number": "${data.order_number}",
                                        "product": "${data.product}",
                                        "amount": "${data.amount}",
                                        "name": "${form.name}",
                                        "address": "${form.address}",
                                        "landmark": "${form.landmark}",
                                        "city": "${form.city}",
                                        "state": "${form.state}",
                                        "pin": "${form.pin}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "DETAILS",
            "title": "Request Details",
            "data": {
                "request_id": {
                    "type": "string",
                    "__example__": "WD-SR-A1B2C3D4"
                },
                "order_number": {
                    "type": "string",
                    "__example__": "WD-PAY-12345678"
                },
                "product": {
                    "type": "string",
                    "__example__": "Service Sample"
                },
                "amount": {
                    "type": "string",
                    "__example__": "\u20b91.00"
                },
                "name": {
                    "type": "string",
                    "__example__": ""
                },
                "address": {
                    "type": "string",
                    "__example__": ""
                },
                "landmark": {
                    "type": "string",
                    "__example__": ""
                },
                "city": {
                    "type": "string",
                    "__example__": ""
                },
                "state": {
                    "type": "string",
                    "__example__": ""
                },
                "pin": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextBody",
                        "text": "Tell us what you need. You can send any photos/files as a WhatsApp message after submitting."
                    },
                    {
                        "type": "Form",
                        "name": "details_form",
                        "children": [
                            {
                                "type": "TextArea",
                                "name": "description",
                                "label": "Describe your request",
                                "required": true,
                                "helper-text": "What would you like us to do?"
                            },
                            {
                                "type": "TextInput",
                                "name": "preferred_time",
                                "label": "Preferred time (optional)",
                                "required": false,
                                "input-type": "text"
                            },
                            {
                                "type": "Footer",
                                "label": "Review \u2192",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "SUCCESS"
                                    },
                                    "payload": {
                                        "request_id": "${data.request_id}",
                                        "order_number": "${data.order_number}",
                                        "product": "${data.product}",
                                        "amount": "${data.amount}",
                                        "name": "${data.name}",
                                        "address": "${data.address}",
                                        "landmark": "${data.landmark}",
                                        "city": "${data.city}",
                                        "state": "${data.state}",
                                        "pin": "${data.pin}",
                                        "description": "${form.description}",
                                        "preferred_time": "${form.preferred_time}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "SUCCESS",
            "title": "Request Confirmed",
            "terminal": true,
            "success": true,
            "data": {
                "request_id": {
                    "type": "string",
                    "__example__": "WD-SR-A1B2C3D4"
                },
                "order_number": {
                    "type": "string",
                    "__example__": "WD-PAY-12345678"
                },
                "product": {
                    "type": "string",
                    "__example__": "Service Sample"
                },
                "amount": {
                    "type": "string",
                    "__example__": "\u20b91.00"
                },
                "name": {
                    "type": "string",
                    "__example__": ""
                },
                "address": {
                    "type": "string",
                    "__example__": ""
                },
                "landmark": {
                    "type": "string",
                    "__example__": ""
                },
                "city": {
                    "type": "string",
                    "__example__": ""
                },
                "state": {
                    "type": "string",
                    "__example__": ""
                },
                "pin": {
                    "type": "string",
                    "__example__": ""
                },
                "description": {
                    "type": "string",
                    "__example__": ""
                },
                "preferred_time": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Request confirmed \ud83c\udf89"
                    },
                    {
                        "type": "TextBody",
                        "text": "We've received your request and will process it within 24-48 hours. Updates will be sent here on WhatsApp."
                    },
                    {
                        "type": "TextCaption",
                        "text": "Your Request ID",
                        "font-weight": "bold"
                    },
                    {
                        "type": "TextSubheading",
                        "text": "${data.request_id}"
                    },
                    {
                        "type": "TextBody",
                        "text": "Please save this ID for reference."
                    },
                    {
                        "type": "Footer",
                        "label": "Done \u2713",
                        "on-click-action": {
                            "name": "complete",
                            "payload": {
                                "request_id": "${data.request_id}",
                                "order_number": "${data.order_number}",
                                "product": "${data.product}",
                                "amount": "${data.amount}",
                                "name": "${data.name}",
                                "address": "${data.address}",
                                "landmark": "${data.landmark}",
                                "city": "${data.city}",
                                "state": "${data.state}",
                                "pin": "${data.pin}",
                                "description": "${data.description}",
                                "preferred_time": "${data.preferred_time}"
                            }
                        }
                    }
                ]
            }
        }
    ]
}