{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": { "ORDER_SELECT": ["NOTES_FORM"], "NOTES_FORM": ["CONFIRM"], "CONFIRM": [] },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Order Notes",
      "data": {
        "orders": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST", "title": "A1B2C3D4 \u2014 22 Feb 2026, 6:00 PM" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Add Order Notes" },
          { "type": "TextBody", "text": "Select an order and add special instructions or notes." },
          { "type": "Dropdown", "name": "order_id", "label": "Select an Order", "required": true, "data-source": "${data.orders}" },
          { "type": "Footer", "label": "Next", "on-click-action": { "name": "data_exchange", "payload": { "order_id": "${form.order_id}" } } }
        ]
      }
    },
    {
      "id": "NOTES_FORM",
      "title": "Add Notes",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "order_label": { "type": "string", "__example__": "A1B2C3D4" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Your Notes" },
          { "type": "TextCaption", "text": "Order" },
          { "type": "TextBody", "text": "${data.order_label}" },
          { "type": "TextArea", "name": "notes", "label": "Notes / Instructions", "required": true, "max-length": 600, "helper-text": "Delivery instructions, gift message, special requests, etc." },
          { "type": "Footer", "label": "Save Notes", "on-click-action": { "name": "data_exchange", "payload": { "order_id": "${data.order_id}", "notes": "${form.notes}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Notes Saved",
      "terminal": true,
      "data": {
        "note_id": { "type": "string", "__example__": "WD-NOTE-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Your notes have been saved to the order." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Notes Saved" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Reference" },
          { "type": "TextSubheading", "text": "${data.note_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}