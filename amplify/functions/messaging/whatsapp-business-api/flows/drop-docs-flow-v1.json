{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "DOC_FORM": ["REVIEW"],
    "REVIEW": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "DOC_FORM",
      "title": "Drop Docs",
      "data": {
        "doc_types": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "id_proof", "title": "ID Proof (Aadhaar, PAN, Passport)" },
            { "id": "address_proof", "title": "Address Proof" },
            { "id": "prescription", "title": "Prescription" },
            { "id": "invoice", "title": "Invoice / Receipt" },
            { "id": "photo", "title": "Photo / Screenshot" },
            { "id": "other", "title": "Other Document" }
          ]
        },
        "orders": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "none", "title": "Not linked to an order" },
            { "id": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST", "title": "A1B2C3D4 \u2014 22 Feb 2026, 6:00 PM" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Drop Your Documents" },
          { "type": "TextBody", "text": "Tell us what you are sending. After submitting this form, send the document as a WhatsApp message (photo, file, or PDF)." },
          { "type": "Dropdown", "name": "doc_type", "label": "Document Type", "required": true, "data-source": "${data.doc_types}" },
          { "type": "Dropdown", "name": "order_id", "label": "Link to Order (optional)", "required": false, "data-source": "${data.orders}" },
          { "type": "TextArea", "name": "description", "label": "Description", "required": false, "max-length": 300, "helper-text": "Brief note about the document." },
          { "type": "Footer", "label": "Next", "on-click-action": { "name": "data_exchange", "payload": { "doc_type": "${form.doc_type}", "order_id": "${form.order_id}", "description": "${form.description}" } } }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review",
      "data": {
        "doc_type": { "type": "string", "__example__": "id_proof" },
        "order_id": { "type": "string", "__example__": "none" },
        "description": { "type": "string", "__example__": "Aadhaar card front and back" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Review Your Submission" },
          { "type": "TextCaption", "text": "Document Type" },
          { "type": "TextBody", "text": "${data.doc_type}" },
          { "type": "TextCaption", "text": "Linked Order" },
          { "type": "TextBody", "text": "${data.order_id}" },
          { "type": "TextCaption", "text": "Description" },
          { "type": "TextBody", "text": "${data.description}" },
          { "type": "TextBody", "text": "After submitting, send the actual document as a WhatsApp message (photo, file, or PDF). We will link it automatically." },
          { "type": "Footer", "label": "Submit", "on-click-action": { "name": "data_exchange", "payload": { "doc_type": "${data.doc_type}", "order_id": "${data.order_id}", "description": "${data.description}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Document Submitted",
      "terminal": true,
      "data": {
        "doc_id": { "type": "string", "__example__": "WD-DOC-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Your document request has been registered. Please send the document as a WhatsApp message now." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Document Registered" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Document Reference" },
          { "type": "TextSubheading", "text": "${data.doc_id}" },
          { "type": "TextBody", "text": "Send the document as a photo, file, or PDF in this chat. We will link it to your reference automatically." },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}