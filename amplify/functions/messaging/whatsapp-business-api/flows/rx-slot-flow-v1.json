{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "SLOT_FORM": ["REVIEW"],
    "REVIEW": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "SLOT_FORM",
      "title": "RX Slot",
      "data": {
        "slot_types": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "prescription", "title": "Prescription Pickup" },
            { "id": "medical_tourism", "title": "Medical Tourism" },
            { "id": "lab_test", "title": "Lab Test" },
            { "id": "pharmacy", "title": "Pharmacy Visit" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Book an RX Slot" },
          { "type": "TextBody", "text": "Schedule a prescription, lab test, or medical visit." },
          { "type": "Dropdown", "name": "slot_type", "label": "Slot Type", "required": true, "data-source": "${data.slot_types}" },
          { "type": "DatePicker", "name": "slot_date", "label": "Preferred Date", "required": true },
          { "type": "TextInput", "name": "slot_time", "label": "Preferred Time", "required": true, "input-type": "text", "max-chars": 20, "helper-text": "e.g. 10:00 AM, 2:30 PM" },
          { "type": "TextInput", "name": "facility_name", "label": "Facility / Clinic Name", "required": false, "input-type": "text", "max-chars": 60, "helper-text": "Optional" },
          { "type": "TextArea", "name": "prescription_notes", "label": "Prescription / Notes", "required": false, "max-length": 400, "helper-text": "Medication names, dosage, or special instructions." },
          { "type": "Footer", "label": "Review Slot", "on-click-action": { "name": "data_exchange", "payload": { "slot_type": "${form.slot_type}", "slot_date": "${form.slot_date}", "slot_time": "${form.slot_time}", "facility_name": "${form.facility_name}", "prescription_notes": "${form.prescription_notes}" } } }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review Slot",
      "data": {
        "slot_type": { "type": "string", "__example__": "prescription" },
        "slot_date": { "type": "string", "__example__": "2026-03-15" },
        "slot_time": { "type": "string", "__example__": "10:00 AM" },
        "facility_name": { "type": "string", "__example__": "Apollo Pharmacy" },
        "prescription_notes": { "type": "string", "__example__": "Metformin 500mg, Amlodipine 5mg" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Review Your Slot" },
          { "type": "TextCaption", "text": "Type" },
          { "type": "TextBody", "text": "${data.slot_type}" },
          { "type": "TextCaption", "text": "Date" },
          { "type": "TextBody", "text": "${data.slot_date}" },
          { "type": "TextCaption", "text": "Time" },
          { "type": "TextBody", "text": "${data.slot_time}" },
          { "type": "TextCaption", "text": "Facility" },
          { "type": "TextBody", "text": "${data.facility_name}" },
          { "type": "TextCaption", "text": "Prescription / Notes" },
          { "type": "TextBody", "text": "${data.prescription_notes}" },
          { "type": "Footer", "label": "Confirm Slot", "on-click-action": { "name": "data_exchange", "payload": { "slot_type": "${data.slot_type}", "slot_date": "${data.slot_date}", "slot_time": "${data.slot_time}", "facility_name": "${data.facility_name}", "prescription_notes": "${data.prescription_notes}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Slot Confirmed",
      "terminal": true,
      "data": {
        "rx_slot_id": { "type": "string", "__example__": "WD-RX-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Your RX slot has been booked. We will confirm shortly." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Slot Confirmed" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Slot Reference" },
          { "type": "TextSubheading", "text": "${data.rx_slot_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}