{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "ORDER_SELECT": ["SELECT_REQUEST"],
    "SELECT_REQUEST": ["AMEND_FORM"],
    "AMEND_FORM": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Amend Request",
      "data": {
        "orders": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST", "title": "A1B2C3D4 \u2014 22 Feb 2026, 6:00 PM" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Amend a Request" },
          { "type": "TextBody", "text": "Select the order linked to the request you want to amend." },
          { "type": "Dropdown", "name": "order_id", "label": "Select an Order", "required": true, "data-source": "${data.orders}" },
          { "type": "Footer", "label": "Next", "on-click-action": { "name": "data_exchange", "payload": { "order_id": "${form.order_id}" } } }
        ]
      }
    },
    {
      "id": "SELECT_REQUEST",
      "title": "Select Request",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "requests": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "WD-SR-E5F6G7H8", "title": "WD-SR-E5F6G7H8 \u2014 Damaged product \u2014 Open" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Select a Request" },
          { "type": "TextBody", "text": "Choose the request you want to amend." },
          { "type": "Dropdown", "name": "request_id", "label": "Select a Request", "required": true, "data-source": "${data.requests}" },
          { "type": "Footer", "label": "Next", "on-click-action": { "name": "data_exchange", "payload": { "order_id": "${data.order_id}", "request_id": "${form.request_id}" } } }
        ]
      }
    },
    {
      "id": "AMEND_FORM",
      "title": "Amendment Details",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "request_id": { "type": "string", "__example__": "WD-SR-E5F6G7H8" },
        "original_subject": { "type": "string", "__example__": "Damaged product" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Describe Your Amendment" },
          { "type": "TextCaption", "text": "Original Subject" },
          { "type": "TextBody", "text": "${data.original_subject}" },
          { "type": "TextArea", "name": "amendment", "label": "Amendment Details", "required": true, "max-length": 600, "helper-text": "Describe what you want to change or add." },
          { "type": "Footer", "label": "Submit Amendment", "on-click-action": { "name": "data_exchange", "payload": { "order_id": "${data.order_id}", "request_id": "${data.request_id}", "amendment": "${form.amendment}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Amendment Submitted",
      "terminal": true,
      "data": {
        "request_id": { "type": "string", "__example__": "WD-SR-E5F6G7H8" },
        "message": { "type": "string", "__example__": "Your amendment has been submitted. Our team will review it shortly." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Amendment Submitted" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Request Reference" },
          { "type": "TextSubheading", "text": "${data.request_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}