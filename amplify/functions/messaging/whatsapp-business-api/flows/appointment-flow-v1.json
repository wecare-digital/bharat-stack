{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "BOOKING_FORM": ["REVIEW"],
    "REVIEW": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "BOOKING_FORM",
      "title": "Book Appointment",
      "data": {
        "appointment_types": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "consultation", "title": "Consultation" },
            { "id": "service_visit", "title": "Service Visit" },
            { "id": "follow_up", "title": "Follow-up" }
          ]
        },
        "locations": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [
            { "id": "office", "title": "Office" },
            { "id": "virtual", "title": "Virtual (Online)" },
            { "id": "home_visit", "title": "Home Visit" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Book an Appointment" },
          { "type": "TextBody", "text": "Schedule a consultation or service visit at a time that works for you." },
          { "type": "Dropdown", "name": "appointment_type", "label": "Appointment Type", "required": true, "data-source": "${data.appointment_types}" },
          { "type": "Dropdown", "name": "location", "label": "Location", "required": true, "data-source": "${data.locations}" },
          { "type": "DatePicker", "name": "slot_date", "label": "Preferred Date", "required": true },
          { "type": "TextInput", "name": "slot_time", "label": "Preferred Time", "required": true, "input-type": "text", "max-chars": 20, "helper-text": "e.g. 10:00 AM, 2:30 PM" },
          { "type": "TextArea", "name": "notes", "label": "Additional Notes", "required": false, "max-length": 300, "helper-text": "Any special requirements or context." },
          { "type": "Footer", "label": "Review Booking", "on-click-action": { "name": "data_exchange", "payload": { "appointment_type": "${form.appointment_type}", "location": "${form.location}", "slot_date": "${form.slot_date}", "slot_time": "${form.slot_time}", "notes": "${form.notes}" } } }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review Booking",
      "data": {
        "appointment_type": { "type": "string", "__example__": "consultation" },
        "location": { "type": "string", "__example__": "office" },
        "slot_date": { "type": "string", "__example__": "2026-03-15" },
        "slot_time": { "type": "string", "__example__": "10:00 AM" },
        "notes": { "type": "string", "__example__": "Need wheelchair access" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Review Your Booking" },
          { "type": "TextCaption", "text": "Type" },
          { "type": "TextBody", "text": "${data.appointment_type}" },
          { "type": "TextCaption", "text": "Location" },
          { "type": "TextBody", "text": "${data.location}" },
          { "type": "TextCaption", "text": "Date" },
          { "type": "TextBody", "text": "${data.slot_date}" },
          { "type": "TextCaption", "text": "Time" },
          { "type": "TextBody", "text": "${data.slot_time}" },
          { "type": "TextCaption", "text": "Notes" },
          { "type": "TextBody", "text": "${data.notes}" },
          { "type": "Footer", "label": "Confirm Booking", "on-click-action": { "name": "data_exchange", "payload": { "appointment_type": "${data.appointment_type}", "location": "${data.location}", "slot_date": "${data.slot_date}", "slot_time": "${data.slot_time}", "notes": "${data.notes}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Booking Confirmed",
      "terminal": true,
      "data": {
        "appointment_id": { "type": "string", "__example__": "WD-APT-A1B2C3D4" },
        "message": { "type": "string", "__example__": "Your appointment has been booked. We will confirm shortly." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "Image", "src": "${WD_LOGO_BASE64}", "scale-type": "contain", "alt-text": "WECARE.DIGITAL" },
          { "type": "TextHeading", "text": "Booking Confirmed" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextCaption", "text": "Appointment Reference" },
          { "type": "TextSubheading", "text": "${data.appointment_id}" },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "data_exchange", "payload": { "confirmed": "true" } } }
        ]
      }
    }
  ]
}