{
  "version": "6.3",
  "data_api_version": "3.0",
  "routing_model": {
    "ORDER_SELECT": ["REQUEST_FORM"],
    "REQUEST_FORM": ["REVIEW"],
    "REVIEW": ["SUCCESS"]
  },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Submit Request",
      "data": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "WD-ORD-A1B2C3D4", "title": "WD-ORD-A1B2C3D4 — 22 Feb 2026" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "📋 WECARE.DIGITAL"
          },
          {
            "type": "TextSubheading",
            "text": "Submit a service request for your order"
          },
          {
            "type": "TextBody",
            "text": "Select your order below. A processing fee of ₹49 applies."
          },
          {
            "type": "Dropdown",
            "name": "order_id",
            "label": "Select Order",
            "required": true,
            "data-source": "${data.orders}"
          },
          {
            "type": "Footer",
            "label": "Continue →",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "order_id": "${form.order_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REQUEST_FORM",
      "title": "Request Details",
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "WD-ORD-A1B2C3D4"
        },
        "request_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "return", "title": "🔄 Return" },
            { "id": "exchange", "title": "🔁 Exchange" },
            { "id": "refund", "title": "💰 Refund" },
            { "id": "complaint", "title": "⚠️ Complaint" },
            { "id": "support", "title": "🛟 Support" },
            { "id": "other", "title": "📝 Other" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "📦 Order: ${data.order_id}"
          },
          {
            "type": "Dropdown",
            "name": "request_type",
            "label": "Request Type",
            "required": true,
            "data-source": "${data.request_types}"
          },
          {
            "type": "TextInput",
            "name": "subject",
            "label": "Subject",
            "required": true,
            "input-type": "text",
            "helper-text": "Brief summary (e.g. Wrong item received)"
          },
          {
            "type": "TextArea",
            "name": "description",
            "label": "Description",
            "required": false,
            "helper-text": "Provide full details about your request"
          },
          {
            "type": "OptIn",
            "name": "terms_accepted",
            "label": "I agree to the terms — ₹49 processing fee (non-refundable)",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Review Request →",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "REVIEW" },
              "payload": {
                "order_id": "${data.order_id}",
                "request_type": "${form.request_type}",
                "subject": "${form.subject}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review & Submit",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD-A1B2C3D4" },
        "request_type": { "type": "string", "__example__": "return" },
        "subject": { "type": "string", "__example__": "Wrong item received" },
        "description": { "type": "string", "__example__": "I received a blue item instead of red" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "📝 Review Your Request"
          },
          {
            "type": "TextCaption",
            "text": "Please verify all details before submitting."
          },
          {
            "type": "TextSubheading",
            "text": "📦 Order"
          },
          {
            "type": "TextBody",
            "text": "${data.order_id}"
          },
          {
            "type": "TextSubheading",
            "text": "📋 Type"
          },
          {
            "type": "TextBody",
            "text": "${data.request_type}"
          },
          {
            "type": "TextSubheading",
            "text": "📌 Subject"
          },
          {
            "type": "TextBody",
            "text": "${data.subject}"
          },
          {
            "type": "TextSubheading",
            "text": "📄 Description"
          },
          {
            "type": "TextBody",
            "text": "${data.description}"
          },
          {
            "type": "TextSubheading",
            "text": "💳 Processing Fee"
          },
          {
            "type": "TextBody",
            "text": "₹49 (non-refundable)"
          },
          {
            "type": "Footer",
            "label": "Submit Request — ₹49",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "order_id": "${data.order_id}",
                "request_type": "${data.request_type}",
                "subject": "${data.subject}",
                "description": "${data.description}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "✅ Request Submitted",
      "terminal": true,
      "data": {
        "request_number": { "type": "string", "__example__": "WD-SR-12345678" },
        "payment_ref_id": { "type": "string", "__example__": "WD-PAY-12345678" },
        "message": { "type": "string", "__example__": "Your request has been submitted successfully!" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "✅ Request Submitted!"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "TextSubheading",
            "text": "🔖 Request Number"
          },
          {
            "type": "TextBody",
            "text": "${data.request_number}"
          },
          {
            "type": "TextSubheading",
            "text": "💳 Payment Reference"
          },
          {
            "type": "TextBody",
            "text": "${data.payment_ref_id}"
          },
          {
            "type": "TextBody",
            "text": "📱 Payment link will be sent via WhatsApp\n⏱️ Review within 24-48 hours\n📩 Updates sent to your WhatsApp"
          },
          {
            "type": "Footer",
            "label": "Done ✓",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "completed"
              }
            }
          }
        ]
      }
    }
  ]
}
