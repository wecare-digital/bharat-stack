{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "ORDER_SELECT": ["STATUS"],
    "STATUS": []
  },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Track Request",
      "data": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST", "title": "A1B2C3D4 \u2014 22 Feb 2026, 6:00 PM" },
            { "id": "WD-ORD - E5F6G7H8 - 21-02-2026 - 10:30:00 - IST", "title": "E5F6G7H8 \u2014 21 Feb 2026, 10:30 AM" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "${WD_LOGO_BASE64}",
            "scale-type": "contain",
            "alt-text": "WECARE.DIGITAL"
          },
          { "type": "TextHeading", "text": "Track Your Request" },
          { "type": "TextBody", "text": "Select an order to view its status and all linked service requests." },
          {
            "type": "Dropdown",
            "name": "order_id",
            "label": "Select an Order",
            "required": true,
            "data-source": "${data.orders}"
          },
          {
            "type": "Footer",
            "label": "Track",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "order_id": "${form.order_id}" }
            }
          }
        ]
      }
    },
    {
      "id": "STATUS",
      "title": "Status Details",
      "terminal": true,
      "data": {
        "order_ref": { "type": "string", "__example__": "A1B2C3D4 \u2014 22 Feb 2026, 6:00 PM" },
        "order_status": { "type": "string", "__example__": "Active \u00b7 Not Fulfilled" },
        "payment_info": { "type": "string", "__example__": "Paid \u2014 \u20b9499" },
        "items_info": { "type": "string", "__example__": "Black Tee \u00d7 1, White Cap \u00d7 2" },
        "requests_summary": { "type": "string", "__example__": "WD-SR-E5F6G7H8 \u2014 Damaged product \u2014 Open" },
        "requests_count": { "type": "string", "__example__": "1 request(s)" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "${WD_LOGO_BASE64}",
            "scale-type": "contain",
            "alt-text": "WECARE.DIGITAL"
          },
          { "type": "TextHeading", "text": "Status Details" },
          { "type": "TextCaption", "text": "Order" },
          { "type": "TextSubheading", "text": "${data.order_ref}" },
          { "type": "TextCaption", "text": "Order Status" },
          { "type": "TextBody", "text": "${data.order_status}" },
          { "type": "TextCaption", "text": "Payment" },
          { "type": "TextBody", "text": "${data.payment_info}" },
          { "type": "TextCaption", "text": "Items" },
          { "type": "TextBody", "text": "${data.items_info}" },
          { "type": "TextCaption", "text": "Service Requests (${data.requests_count})" },
          { "type": "TextBody", "text": "${data.requests_summary}" },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "confirmed": "true" }
            }
          }
        ]
      }
    }
  ]
}