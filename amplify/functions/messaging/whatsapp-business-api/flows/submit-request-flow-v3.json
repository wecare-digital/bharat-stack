{
  "version": "7.3",
  "data_api_version": "4.0",
  "routing_model": {
    "ORDER_SELECT": ["SUBMIT_REQUEST_FORM"],
    "SUBMIT_REQUEST_FORM": ["TERMS"],
    "TERMS": ["REVIEW"],
    "REVIEW": ["THANK_YOU"],
    "THANK_YOU": []
  },
  "screens": [
    {
      "id": "ORDER_SELECT",
      "title": "Submit Request",
      "data": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST", "title": "WD-ORD - A1B2C3D4" },
            { "id": "WD-ORD - E5F6G7H8 - 21-02-2026 - 10:30:00 - IST", "title": "WD-ORD - E5F6G7H8" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "${WD_LOGO_BASE64}",
            "scale-type": "contain",
            "alt-text": "WECARE.DIGITAL"
          },
          { "type": "TextHeading", "text": "Submit a Request" },
          { "type": "TextBody", "text": "Select the order you need help with. A \u20b949 service fee applies to each request." },
          {
            "type": "Dropdown",
            "name": "order_id",
            "label": "Select an Order",
            "required": true,
            "data-source": "${data.orders}"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "order_id": "${form.order_id}" }
            }
          }
        ]
      }
    },
    {
      "id": "SUBMIT_REQUEST_FORM",
      "title": "Request Details",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Describe Your Issue" },
          { "type": "TextBody", "text": "Provide the details of your request below." },
          { "type": "TextCaption", "text": "Order ID" },
          { "type": "TextBody", "text": "${data.order_id}" },
          {
            "type": "TextInput",
            "name": "subject",
            "label": "Subject",
            "required": true,
            "input-type": "text",
            "max-chars": 80,
            "helper-text": "Short summary of your issue"
          },
          {
            "type": "TextArea",
            "name": "description",
            "label": "Description",
            "required": true,
            "max-length": 600,
            "helper-text": "Share relevant details for support."
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "order_id": "${data.order_id}",
                "subject": "${form.subject}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "TERMS",
      "title": "Terms & Conditions",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "subject": { "type": "string", "__example__": "Damaged product" },
        "description": { "type": "string", "__example__": "The item arrived with a broken seal." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Terms and Service Fee" },
          {
            "type": "TextBody",
            "markdown": true,
            "text": "By submitting this request, you agree to the following:\n\n1. A non-refundable fee of **\u20b949** applies to each request.\n2. Our team will review your request within **24 hours** during business hours.\n3. Business hours are **Monday to Friday, 9:00 AM to 6:00 PM IST**, excluding public holidays. Requests received outside business hours are reviewed on the next working day.\n4. WECARE.DIGITAL may contact you for additional details needed to process the request.\n5. A payment request is generated **after** the request is submitted."
          },
          {
            "type": "EmbeddedLink",
            "text": "View Orders",
            "on-click-action": { "name": "open_url", "url": "https://www.wecare.digital/orders" }
          },
          {
            "type": "Form",
            "name": "terms_form",
            "children": [
              {
                "type": "OptIn",
                "name": "accept_terms",
                "label": "I agree to the Terms & Conditions",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Review Request",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "REVIEW" },
                  "payload": {
                    "order_id": "${data.order_id}",
                    "subject": "${data.subject}",
                    "description": "${data.description}",
                    "accepted_terms": "${form.accept_terms}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review and Submit",
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "subject": { "type": "string", "__example__": "Damaged product" },
        "description": { "type": "string", "__example__": "The item arrived with a broken seal." },
        "accepted_terms": { "type": "boolean", "__example__": true }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Review Your Request" },
          { "type": "TextCaption", "text": "Order ID", "font-weight": "bold" },
          { "type": "TextBody", "text": "${data.order_id}" },
          { "type": "TextCaption", "text": "Subject", "font-weight": "bold" },
          { "type": "TextBody", "text": "${data.subject}" },
          { "type": "TextCaption", "text": "Description", "font-weight": "bold" },
          { "type": "TextBody", "text": "${data.description}" },
          { "type": "TextCaption", "text": "Service Fee", "font-weight": "bold" },
          { "type": "TextBody", "text": "\u20b949 (non-refundable)" },
          { "type": "TextCaption", "text": "A payment request will be sent after submission." },
          {
            "type": "Form",
            "name": "review_form",
            "children": [
              {
                "type": "OptIn",
                "name": "confirm_submit",
                "label": "I confirm the details are correct and agree to pay \u20b949",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Submit Request",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "order_id": "${data.order_id}",
                    "subject": "${data.subject}",
                    "description": "${data.description}",
                    "accepted_terms": "${data.accepted_terms}",
                    "confirmed": "${form.confirm_submit}",
                    "service_fee_amount": "49",
                    "payment_required": "true"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "THANK_YOU",
      "title": "Request Submitted",
      "terminal": true,
      "data": {
        "order_id": { "type": "string", "__example__": "WD-ORD - A1B2C3D4 - 22-02-2026 - 18:00:00 - IST" },
        "request_number": { "type": "string", "__example__": "WD-SR-A1B2C3D4" },
        "payment_ref_id": { "type": "string", "__example__": "WD-PAY-E5F6G7H8" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "${WD_LOGO_BASE64}",
            "scale-type": "contain",
            "alt-text": "WECARE.DIGITAL"
          },
          { "type": "TextHeading", "text": "Thank You!" },
          { "type": "TextBody", "text": "Your request has been submitted successfully." },
          { "type": "TextCaption", "text": "Order ID" },
          { "type": "TextSubheading", "text": "${data.order_id}" },
          { "type": "TextCaption", "text": "Request Number" },
          { "type": "TextSubheading", "text": "${data.request_number}" },
          { "type": "TextCaption", "text": "Payment Reference" },
          { "type": "TextSubheading", "text": "${data.payment_ref_id}" },
          { "type": "TextBody", "text": "A payment request for \u20b949 will be sent shortly. Keep the request number and payment reference for tracking." },
          { "type": "TextCaption", "text": "Thank you for choosing WECARE.DIGITAL" },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "confirmed": "true" }
            }
          }
        ]
      }
    }
  ]
}