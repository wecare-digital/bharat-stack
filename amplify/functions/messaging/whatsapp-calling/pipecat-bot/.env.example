# AWS Credentials (use IAM role on Lightsail/EC2 instead if possible)
# If running on EC2/Lightsail with IAM role, leave these blank
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Meta tokens — loaded from Secrets Manager automatically (same as Lambda)
# Only set these if you want to OVERRIDE Secrets Manager values
# WHATSAPP_TOKEN=
# WHATSAPP_APP_SECRET=
META_TOKEN_SECRET=wecare/meta-system-user-token

# Phone number IDs (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=960395407161423
WHATSAPP_PHONE_NUMBER_ID_WABA2=997428863451102

# Webhook verification
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=wecare_calling_verify_2026

# AI Config
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=neural
POLLY_LANGUAGE=en-IN
TRANSCRIBE_LANGUAGE=en-IN

# Bedrock Agent (optional — for agentic responses)
AI_AGENT_ID=Z4YAK0ZLBO
AI_AGENT_ALIAS=WANPKHQGIB

# Server
HOST=0.0.0.0
PORT=8765
CALL_TIMEOUT=30

# Lambda callback (to notify Lambda of call events)
LAMBDA_CALLBACK_URL=https://api.wecare.digital/whatsapp-calling
