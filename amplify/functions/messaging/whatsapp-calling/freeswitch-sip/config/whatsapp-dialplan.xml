<!--
  WhatsApp Inbound Call Dialplan
  
  When Meta forwards a WhatsApp call via SIP, it arrives here.
  We answer the call, record audio for AI processing, and use
  the ESL (Event Socket) to control the call from our Python bridge.
  
  The Python bridge (ai_bridge.py) connects via ESL and:
  1. Listens for new calls
  2. Records caller audio in chunks
  3. Sends audio to AWS Transcribe for STT
  4. Sends text to Bedrock Nova Lite for AI response
  5. Generates TTS via Amazon Polly
  6. Plays TTS audio back to the caller
-->
<include>
  <extension name="whatsapp-inbound-ai">
    <condition field="destination_number" expression=".*">
      <!-- Answer the call -->
      <action application="answer"/>
      
      <!-- Set call variables for the AI bridge -->
      <action application="set" data="api_hangup_hook=lua goodbye.lua"/>
      <action application="set" data="playback_terminators=none"/>
      <action application="set" data="RECORD_STEREO=false"/>
      <action application="set" data="RECORD_SAMPLE_RATE=16000"/>
      
      <!-- Play a brief greeting while AI initializes -->
      <action application="say" data="en CURRENT_DATE_TIME pronounced ${strepoch()}"/>
      <action application="sleep" data="200"/>
      
      <!-- 
        Start recording the call audio to a file.
        The Python ESL bridge monitors this file and processes chunks.
        record_session records both legs; we want caller audio only.
      -->
      <action application="set" data="RECORD_READ_ONLY=true"/>
      <action application="record_session" data="/tmp/wecare-recordings/${uuid}_caller.wav"/>
      
      <!-- 
        Park the call — keeps it alive while the ESL bridge controls it.
        The bridge will play TTS audio and eventually hang up.
      -->
      <action application="park"/>
    </condition>
  </extension>
</include>
