<!--
  External SIP Profile — receives WhatsApp calls from Meta.
  
  Meta's WhatsApp SIP gateway sends:
  - SIP INVITE over TLS (port 5061)
  - Media encrypted with DTLS-SRTP
  - Codec: Opus (preferred) or G.711
  - No SIP registration — direct INVITE
-->
<profile name="external">
  <aliases>
  </aliases>
  <gateways>
  </gateways>
  <domains>
    <domain name="all" alias="false" parse="true"/>
  </domains>
  <settings>
    <!-- SIP signaling -->
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="sip-port" value="5080"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    
    <!-- External IP for SDP (NAT traversal) -->
    <param name="ext-rtp-ip" value="98.80.207.92"/>
    <param name="ext-sip-ip" value="98.80.207.92"/>

    <!-- TLS for SIP signaling -->
    <!-- Meta does NOT support mTLS — do NOT request client certificate -->
    <param name="tls" value="true"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-sip-port" value="5081"/>
    <param name="tls-version" value="tlsv1.2"/>
    <param name="tls-cert-dir" value="/etc/freeswitch/tls/"/>
    <param name="tls-verify-policy" value="none"/>
    <param name="tls-verify-in-subjects" value=""/>

    <!-- SRTP — required by WhatsApp -->
    <param name="rtp-secure-media" value="true"/>
    <param name="rtp-secure-media-suites" value="AEAD_AES_256_GCM_8,AEAD_AES_128_GCM_8,AES_CM_256_HMAC_SHA1_80,AES_CM_128_HMAC_SHA1_80"/>
    
    <!-- Accept calls without authentication (Meta doesn't register) -->
    <param name="auth-calls" value="false"/>
    <param name="apply-inbound-acl" value="any_v4.auto"/>

    <!-- Codecs -->
    <param name="inbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="inbound-codec-negotiation" value="generous"/>

    <!-- Route inbound calls to our WhatsApp dialplan context -->
    <param name="context" value="whatsapp-inbound"/>

    <!-- RTP settings -->
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-rewrite-timestamps" value="true"/>

    <!-- NAT -->
    <param name="aggressive-nat-detection" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>

    <!-- Disable presence/registration (not needed) -->
    <param name="manage-presence" value="false"/>
    <param name="manage-shared-appearance" value="false"/>
    
    <!-- Disable re-INVITEs — Meta returns 500 Internal Server Error on re-INVITE -->
    <param name="disable-hold" value="true"/>

    <!-- Misc -->
    <param name="nonce-ttl" value="60"/>
    <param name="inbound-reg-force-matching-username" value="false"/>
    <param name="disable-register" value="true"/>
  </settings>
</profile>
