[Unit]
Description=WeCare AI Voice Bridge (FreeSWITCH ESL)
After=network.target docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/freeswitch
ExecStart=/opt/freeswitch/venv/bin/python /opt/freeswitch/scripts/ai_bridge.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/wecare-bot/.env

[Install]
WantedBy=multi-user.target
