{
  "name": "wecare-digital-admin-platform",
  "version": "1.0.0",
  "description": "WECARE.DIGITAL Admin Platform - Multi-channel messaging system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "amplify": "ampx sandbox",
    "amplify:deploy": "ampx pipeline-deploy",
    "cap:init": "npx cap init \"Stack CRM\" digital.wecare.stackcrm --web-dir out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:build": "next build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@aws-amplify/backend": "^1.8.0",
    "@aws-amplify/ui-react": "^6.12.0",
    "@aws-sdk/client-bedrock": "^3.1037.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1036.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "aws-amplify": "^6.14.0",
    "flag-icons": "^7.5.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@aws-amplify/backend-cli": "^1.7.2",
    "@aws-amplify/backend-data": "^1.1.3",
    "@aws-amplify/data-construct": "^1.10.0",
    "@aws-amplify/graphql-schema-generator": "^0.11.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "lodash": "4.17.21",
    "fast-xml-parser": "5.3.4"
  }
}