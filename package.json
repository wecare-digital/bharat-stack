{
  "name": "wecare-digital-admin-platform",
  "version": "1.0.0",
  "description": "WECARE.DIGITAL Admin Platform - Multi-channel messaging system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "amplify": "ampx sandbox",
    "amplify:deploy": "ampx pipeline-deploy",
    "cap:init": "npx cap init \"Stack CRM\" digital.wecare.stackcrm --web-dir out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:build": "next build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/ui-react": "^6.15.4",
    "@aws-sdk/client-bedrock": "^3.1076.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1076.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "aws-amplify": "^6.18.0",
    "aws-cdk-lib": "2.262.1",
    "constructs": "10.7.1",
    "flag-icons": "^7.5.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@aws-amplify/backend-cli": "^1.8.3",
    "@aws-amplify/backend-data": "^1.7.0",
    "@aws-amplify/data-construct": "^1.17.3",
    "@aws-amplify/graphql-schema-generator": "^0.11.14",
    "@testing-library/dom": "10.4.1",
    "esbuild": "^0.25.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "lodash": "4.17.21",
    "fast-xml-parser": "5.9.3"
  }
}