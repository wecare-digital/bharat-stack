  "capturedAt": "2026-09-28T06:43:25.551512+00:00",
  "policy": {
    "Version": "2012-10-17",
    "Id": "wecare-digital-get-oac-policy",
    "Statement": [
      {
        "Sid": "AllowCloudFrontServicePrincipalReadOnly",
        "Effect": "Allow",
        "Principal": {
          "Service": "cloudfront.amazonaws.com"
        },
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::wecare-digital-get/*",
        "Condition": {
          "StringEquals": {
            "AWS:SourceArn": "arn:aws:cloudfront::775261844268:distribution/E2GP22R4BIFGQ3"
          }
        }
      },
      {
        "Sid": "DenyInsecureTransport",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": [
          "arn:aws:s3:::wecare-digital-get",
          "arn:aws:s3:::wecare-digital-get/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      }
    ]
  }
}