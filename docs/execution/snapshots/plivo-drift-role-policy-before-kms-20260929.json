{
    "RoleName": "GitHubActions-wecare-digital-plivo-drift",
    "PolicyName": "PlivoSecretReadOnly",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ReadOnlyThePlivoApiSecret",
                "Effect": "Allow",
                "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:DescribeSecret"
                ],
                "Resource": "arn:aws:secretsmanager:us-east-1:775261844268:secret:wecare/plivo/api-??????"
            },
            {
                "Sid": "DenyEveryOtherSecret",
                "Effect": "Deny",
                "Action": "secretsmanager:*",
                "NotResource": "arn:aws:secretsmanager:us-east-1:775261844268:secret:wecare/plivo/api-??????"
            }
        ]
    }
}
