# Sinch RCS — the only five variables this project needs from Sinch.
#
# Consumed by the `sinch-rcs` MCP server in .kiro/settings/mcp.json, which is
# referenced as ${SINCH_...} so no value is ever written into that file.
#
# These are for TOOLING ONLY. The running application does not read them: it loads
# its Sinch credentials from AWS Secrets Manager (`wecare/sinch/rcs`) at request
# time. Adding them here does not change any runtime behaviour.

# From the project selector in the Sinch Build dashboard.
# Our application's configured project id is a UUID and is already stored in
# `wecare/sinch/rcs` under `project_id`.
SINCH_PROJECT_ID=

# From Settings -> Access keys in the Sinch Build dashboard.
#
# NEITHER OF THESE EXISTS YET. Verified 2026-09-22: `wecare/sinch/rcs` contains
# exactly five fields - app_id, bot_id, password, project_id, username - and no
# key_id or key_secret. The MCP server refuses to start on a partial triple
# ("set all three, or none and a mode"), so it ships disabled until these exist.
#
# The access key secret is shown ONCE at creation. If it is lost, a new access key
# must be created.
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# The Conversation API app that carries the RCS channel. Our application's value is
# a ULID stored in `wecare/sinch/rcs` under `app_id`.
SINCH_CONVERSATION_APP_ID=

# Conversation API region. Must match the region of the RCS Sender bound to the app,
# or the channel cannot work.
SINCH_CONVERSATION_REGION=

# ── Deliberately absent ───────────────────────────────────────────────────────
#
# This is an RCS-only Sinch integration, so the following are NOT set, and the MCP
# server is started with `--tags rcs,conversation` so their tool groups never load:
#
#   DEFAULT_SMS_ORIGINATOR        SMS
#   APPLICATION_KEY               Voice / Verification
#   APPLICATION_SECRET            Voice / Verification
#   CALLING_LINE_IDENTIFICATION   Voice
#   MAILGUN_API_KEY               Email
#   MAILGUN_DOMAIN                Email
#   MAILGUN_SENDER_ADDRESS        Email
#   GEOCODING_API_KEY             location feature, unused here
#
# The `conversation` tag still exposes three tools that would breach the RCS-only
# rule - set-whatsapp-channel-on-app, send-whatsapp-template-message and
# set-sms-channel-on-app - so they are listed in `disabledTools` rather than being
# left to discipline.


# ---------------------------------------------------------------------------
# Google Maps Embed API — the map on /contact/
# ---------------------------------------------------------------------------
# Used by src/components/ContactLocation.tsx. Without it the page renders a
# styled "Open the map" panel instead of an iframe, which is deliberate: an
# Embed API iframe with no key paints a Google error page inside our frame.
#
# THIS VALUE ENDS UP PUBLIC. output:'export' inlines NEXT_PUBLIC_* at build
# time, so it is readable in the page source. That is unavoidable and normal —
# any browser rendering a Google map can read the key that rendered it. The
# protection is a restriction, not secrecy:
#
#   1. Create a SEPARATE key for this. Do not reuse the key that also carries
#      Weather, Air Quality or Solar: those are server-side APIs that cannot be
#      referrer-restricted, so publishing that key would expose three paid APIs
#      instead of one.
#   2. Restrict it to "Websites" (HTTP referrers):
#        https://wecare.digital/*
#        https://stack.wecare.digital/*
#   3. Under API restrictions, enable ONLY "Maps Embed API".
#
# An unrestricted key in a public page is billable by anyone who copies it.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
