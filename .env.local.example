# =============================================================================
# WECARE.DIGITAL — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Cognito Auth ---
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=signin.yourdomain.com

# --- App URLs ---
NEXT_PUBLIC_APP_URL=https://stack.wecare.digital/
NEXT_PUBLIC_API_BASE=https://api.wecare.digital

# --- Internal Agent (Lambda Function URL) ---
NEXT_PUBLIC_INTERNAL_AGENT_URL=https://your-lambda-function-url.lambda-url.us-east-1.on.aws

# --- AWS ---
NEXT_PUBLIC_AWS_ACCOUNT_ID=000000000000
NEXT_PUBLIC_AWS_REGION=us-east-1

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S3G6REP6Q7
NEXT_PUBLIC_FB_APP_ID=0000000000000000

# --- Payment ---
NEXT_PUBLIC_PAYMENT_PHONE_ID=phone-number-id-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_PAYMENT_PHONE_DISPLAY=+91 XXXXX XXXXX
NEXT_PUBLIC_PAYMENT_PHONE_NAME=YOUR_NAME
NEXT_PUBLIC_DEFAULT_GSTIN=XXAADFW0000X0XX

# --- Mode ---
NEXT_PUBLIC_SEND_MODE=LIVE
NEXT_PUBLIC_ENV=production

# --- Wix Headless Integration (fresh project only) ---
WIX_API_KEY_SECRET=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# --- AI / Bedrock ---
BEDROCK_AGENT_ID=your-bedrock-agent-id
BEDROCK_AGENT_ALIAS=your-bedrock-agent-alias
BEDROCK_KB_ID=your-bedrock-knowledge-base-id

# --- Razorpay ---
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- WhatsApp Calling ---
WHATSAPP_CALLING_VERIFY_TOKEN=your-verify-token

# --- Payment Protection ---
NEXT_PUBLIC_PAYMENT_UNLOCK_PASSWORD=your-payment-unlock-password

# --- SEO Platform Backend ---
NEXT_PUBLIC_SEO_API_URL=http://localhost:8000

# =============================================================================
# WhatsApp Business Platform (Meta Cloud API) — server-side / Lambda env
# These are consumed by the wecare-* Lambdas (deployed via scripts/deploy_all.ps1),
# not by the Next.js frontend. Secret values live in AWS Secrets Manager
# (wecare/meta-system-user-token, wecare/meta-app-secret, wecare/flow-private-key);
# the variables below document the contract and drive feature flags.
# =============================================================================
META_GRAPH_API_VERSION=v25.0
WA_ACCESS_TOKEN=            # from Secrets Manager wecare/meta-system-user-token (access_token)
WA_APP_SECRET=              # from Secrets Manager wecare/meta-app-secret / meta token (app_secret) — used for appsecret_proof + webhook signature
WA_VERIFY_TOKEN=            # webhook GET hub.verify_token (AWS End User Messaging managed)
WA_BUSINESS_ID=             # Meta Business (portfolio) ID
WA_WABA_ID=2094615664435155 # WABA 1 (WECARE.DIGITAL); WABA 2 = 2513394156072604
WA_PHONE_NUMBER_ID=1016149501586345  # WABA 1 phone id; WABA 2 = 1055232054343117
WA_CATALOG_ID=              # required only if WA catalog/product messages enabled
WA_DEFAULT_LANGUAGE=en_US

# --- Live smoke test gating (NEVER enable in normal operation) ---
WA_LIVE_SMOKE_TEST=false
WA_QA_RECIPIENT=            # e.g. 91XXXXXXXXXX — required for any live send test

# --- Feature flags (Meta-gated capabilities) ---
WA_FLOWS_ENABLED=true
WA_PAYMENTS_ENABLED=false
WA_MARKETING_MESSAGES_ENABLED=false
WA_CALLING_ENABLED=false
WA_GROUPS_ENABLED=false

# --- Media + webhook infra ---
WA_MEDIA_BUCKET=app.wecare.digital
WA_WEBHOOK_QUEUE_URL=       # SQS inbound queue (if used)
WA_WEBHOOK_DLQ_URL=https://sqs.us-east-1.amazonaws.com/775261844268/stack-wecare-digital-inbound-dlq

# ============================================================================
# Integrations with official SDKs installed 2026-09-18
# Secret VALUES live in AWS Secrets Manager; the variables below document the
# contract. Fetch secrets lazily inside the handler, never at import time -
# SnapStart snapshots module-level state, so a rotated secret would stay
# frozen in the snapshot until the function is republished.
# ============================================================================

# --- Plivo Voice / SIP  (secret: wecare/plivo/api) ---
# Used for the Meta WhatsApp Calling -> SIP -> Plivo -> Lambda -> S3 IVR path.
# Plivo WhatsApp Calling is NOT used. Keep Meta messaging independent of Plivo.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APPLICATION_ID=
PLIVO_ANSWER_URL=
# Optional, future real-time streaming only (plivo-stream-sdk-node).
# Do not enable for the fixed IVR.
PLIVO_STREAM_ENABLED=

# --- Razorpay  (secret: wecare/razorpay/api, webhook: wecare/razorpay-webhook) ---
# LIVE mode. Also backs the Meta WABA payment configuration named
# WECAREDIGITAL - see wecare/meta/payments for the config-to-MID mapping.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_ID=

# --- Meta WABA payment configurations  (secret: wecare/meta/payments) ---
# Config names attached to order_details messages. MCC 7392, purpose code 03.
WA_PAYMENT_CONFIG_GATEWAY=
WA_PAYMENT_CONFIG_UPI=

# --- OpenAI  (secret: wecare/openai/api) ---
# Note: primary AI in this stack is AWS Bedrock. OpenAI is supplementary.
# The ads key is a service account scoped to the Ads API only - it cannot
# call model endpoints.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_ADS_API_KEY=

# --- Google Ads / Ad Manager  (secrets: wecare/google/ads, wecare/ads/account-registry) ---
# The google-ads SDK needs the OAuth trio below in addition to the developer
# token; supplying only the developer token is not enough to authenticate.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_AD_MANAGER_NETWORK_CODE=

# --- Bing Webmaster  (secret: wecare/bing/api) ---
# REST only, no SDK exists.
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_SITE_URL=

# --- Analytics / profile identifiers (secret: wecare/ads/account-registry) ---
GA4_PROPERTY_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION=
META_ADS_ACCOUNT_IDS=
