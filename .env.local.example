# =============================================================================
# WECARE.DIGITAL — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Cognito Auth ---
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=signin.yourdomain.com

# --- App URLs ---
# Must be a REGISTERED Cognito callback/logout URL, because _app.tsx passes it to
# Amplify as the OAuth redirect URI and Cognito rejects an unregistered host with
# redirect_mismatch. Do not point it at a host that redirects: stack.wecare.digital
# used to be the value here and only 301'd to the apex, which worked solely because
# the 301 happened to preserve the ?code=.
NEXT_PUBLIC_APP_URL=https://wecare.digital/
NEXT_PUBLIC_API_BASE=https://api.wecare.digital

# --- Internal Agent (Lambda Function URL) ---
NEXT_PUBLIC_INTERNAL_AGENT_URL=https://your-lambda-function-url.lambda-url.us-east-1.on.aws

# --- AWS ---
NEXT_PUBLIC_AWS_ACCOUNT_ID=000000000000
NEXT_PUBLIC_AWS_REGION=us-east-1

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S3G6REP6Q7
NEXT_PUBLIC_FB_APP_ID=0000000000000000

# --- Payment ---
NEXT_PUBLIC_PAYMENT_PHONE_ID=phone-number-id-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_PAYMENT_PHONE_DISPLAY=+91 XXXXX XXXXX
NEXT_PUBLIC_PAYMENT_PHONE_NAME=YOUR_NAME
NEXT_PUBLIC_DEFAULT_GSTIN=XXAADFW0000X0XX

# --- Mode ---
NEXT_PUBLIC_SEND_MODE=LIVE
NEXT_PUBLIC_ENV=production

# --- Wix Headless Integration (fresh project only) ---
WIX_API_KEY_SECRET=wecare/wix/headless-api-key
WIX_SITE_ID=fcd82f0c-9572-49c7-acfb-88fb05042ece
WIX_ACCOUNT_ID=15f02319-40ff-4288-b8e6-69c791adae5e

# --- AI / Bedrock ---
BEDROCK_AGENT_ID=your-bedrock-agent-id
BEDROCK_AGENT_ALIAS=your-bedrock-agent-alias
BEDROCK_KB_ID=your-bedrock-knowledge-base-id

# --- Razorpay ---
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- WhatsApp Calling ---
WHATSAPP_CALLING_VERIFY_TOKEN=your-verify-token

# --- Payment Protection ---
NEXT_PUBLIC_PAYMENT_UNLOCK_PASSWORD=your-payment-unlock-password

# --- SEO Platform Backend ---
NEXT_PUBLIC_SEO_API_URL=http://localhost:8000

# =============================================================================
# WhatsApp Business Platform (Meta Cloud API) — server-side / Lambda env
# These are consumed by the wecare-* Lambdas (deployed via scripts/deploy_all.ps1),
# not by the Next.js frontend. Secret values live in AWS Secrets Manager
# (wecare/meta-system-user-token, wecare/meta-app-secret, wecare/flow-private-key);
# the variables below document the contract and drive feature flags.
# =============================================================================
META_GRAPH_API_VERSION=v25.0
WA_ACCESS_TOKEN=            # from Secrets Manager wecare/meta-system-user-token (access_token)
WA_APP_SECRET=              # from Secrets Manager wecare/meta-app-secret / meta token (app_secret) — used for appsecret_proof + webhook signature
WA_VERIFY_TOKEN=            # webhook GET hub.verify_token (AWS End User Messaging managed)
WA_BUSINESS_ID=             # Meta Business (portfolio) ID
WA_WABA_ID=2094615664435155 # WABA 1 (WECARE.DIGITAL); WABA 2 = 2513394156072604
WA_PHONE_NUMBER_ID=1016149501586345  # WABA 1 phone id; WABA 2 = 1055232054343117
WA_CATALOG_ID=              # required only if WA catalog/product messages enabled
WA_DEFAULT_LANGUAGE=en_US

# --- Live smoke test gating (NEVER enable in normal operation) ---
WA_LIVE_SMOKE_TEST=false
WA_QA_RECIPIENT=            # e.g. 91XXXXXXXXXX — required for any live send test

# --- Feature flags (Meta-gated capabilities) ---
WA_FLOWS_ENABLED=true
WA_PAYMENTS_ENABLED=false
WA_MARKETING_MESSAGES_ENABLED=false
WA_CALLING_ENABLED=false
WA_GROUPS_ENABLED=false

# --- Media + webhook infra ---
WA_MEDIA_BUCKET=app.wecare.digital
WA_WEBHOOK_QUEUE_URL=       # SQS inbound queue (if used)
WA_WEBHOOK_DLQ_URL=https://sqs.us-east-1.amazonaws.com/775261844268/stack-wecare-digital-inbound-dlq

# ============================================================================
# Integrations with official SDKs installed 2026-09-18
# Secret VALUES live in AWS Secrets Manager; the variables below document the
# contract. Fetch secrets lazily inside the handler, never at import time -
# SnapStart snapshots module-level state, so a rotated secret would stay
# frozen in the snapshot until the function is republished.
# ============================================================================

# --- Plivo Voice / SIP  (secret: wecare/plivo/api) ---
# Used for the Meta WhatsApp Calling -> SIP -> Plivo -> Lambda -> S3 IVR path.
# Plivo WhatsApp Calling is NOT used. Keep Meta messaging independent of Plivo.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APPLICATION_ID=
PLIVO_ANSWER_URL=
# Optional, future real-time streaming only (plivo-stream-sdk-node).
# Do not enable for the fixed IVR.
PLIVO_STREAM_ENABLED=

# --- Razorpay  (secret: wecare/razorpay/api, webhook: wecare/razorpay-webhook) ---
# LIVE mode. Also backs the Meta WABA payment configuration named
# WECAREDIGITAL - see wecare/meta/payments for the config-to-MID mapping.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_ID=

# --- Meta WABA payment configurations  (secret: wecare/meta/payments) ---
# Config names attached to order_details messages. MCC 7392, purpose code 03.
WA_PAYMENT_CONFIG_GATEWAY=
WA_PAYMENT_CONFIG_UPI=

# --- OpenAI  (secret: wecare/openai/api) ---
# Note: primary AI in this stack is AWS Bedrock. OpenAI is supplementary.
# The ads key is a service account scoped to the Ads API only - it cannot
# call model endpoints.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_ADS_API_KEY=

# --- Google Ads / Ad Manager  (secrets: wecare/google/ads, wecare/ads/account-registry) ---
# The google-ads SDK needs the OAuth trio below in addition to the developer
# token; supplying only the developer token is not enough to authenticate.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_AD_MANAGER_NETWORK_CODE=

# --- Bing Webmaster  (secret: wecare/bing/api) ---
# REST only, no SDK exists.
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_SITE_URL=

# --- Analytics / profile identifiers (secret: wecare/ads/account-registry) ---
GA4_PROPERTY_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION=
META_ADS_ACCOUNT_IDS=

# --- SEO / site verification  (public once rendered, still env-managed) ---
# Omitted from <head> entirely when blank: an empty content="" verification tag looks
# configured and is not.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Google Analytics 4 ---
# MEASUREMENT ID (G-XXXXXXXXXX), per data stream. NOT the GA4 property number.
# The WECARE.DIGITAL property is 550346663, recorded in src/config/analytics.ts - that
# number is only usable from the Admin/Data APIs server-side and gtag.js will not
# accept it, so this still needs the G- value from the data stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Cloud  (project wecaredigitalbw / 756034744787) ---
# The Unified API key is a CREDENTIAL. Server-side only, from Secrets Manager
# (wecare/google/api-key). Never NEXT_PUBLIC_*, or it ships to every visitor in the
# client bundle. Restrict it by API and by referrer in the Cloud console regardless.
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=


# --- Google Maps browser key (the contact map) ---
# THIS ONE IS DELIBERATELY NEXT_PUBLIC_, unlike GOOGLE_API_KEY above, and the difference
# is not an inconsistency. A Maps *browser* key is public by design: Google's own model is
# to restrict it by HTTP referrer rather than to hide it. GOOGLE_API_KEY is a server-side
# credential and must never be NEXT_PUBLIC_.
#
# WHAT SETTING IT CHANGES, in src/components/ContactLocation.tsx:
#   unset (today)  keyless iframe embed. Google paints three controls inside a
#                  cross-origin frame - a camera control, a satellite toggle and
#                  "Keyboard shortcuts" - and nothing in this repo can remove them.
#   set            Maps JavaScript API into a div we own, with disableDefaultUI, so all
#                  three controls are GONE rather than covered; satellite imagery; and
#                  our own lime #d1f470 pin with a #1a3a2a stroke and a WECARE.DIGITAL
#                  label in this site's type.
#
# It does NOT remove "Map data (c)2026 Google" or "Terms". Those are attribution, a
# licence condition of Maps Platform, and they stay on every path - keyless embed, Maps
# JS and Static Maps alike.
#
# IT IS READ AT BUILD TIME. next.config.js uses output:'export', so the value is inlined
# into a JS chunk under out/_next/static/chunks/ during `npm run build`. Setting it in the
# Amplify console therefore does nothing until the next deploy. Measured: it appears in
# exactly one JS chunk and in ZERO html files, so checking with View Source finds nothing
# and is not evidence that the key is absent - check for an <iframe> in /contact/ instead,
# because the keyed path renders a plain <div> with no iframe at all.
#
# TWO THINGS TO SET IN THE CLOUD CONSOLE, neither enforceable from this repo. With
# Application restrictions left at None, anyone who reads that chunk can bill the project:
#   Application restrictions -> HTTP referrers: wecare.digital/* AND *.wecare.digital/*
#                               (the apex alone misses www)
#   API restrictions         -> Maps JavaScript API only (add Static Maps / Places only
#                               if something starts using them)
#
# DO NOT COMMIT A REAL KEY. .env* is gitignored, and scripts/block_inline_secrets.py
# rejects any AIza-prefixed string, so a hardcoded key is blocked by the repo itself.
# Put the real value in Amplify env vars, or in a local .env.local for testing.
#
# Verify after setting it: `node tools/browser/contactcheck.js` switches to its keyed
# branch and asserts the div was actually painted, that no controls survived, and that
# attribution is still present. A rejected key, a referrer restriction that excludes the
# origin, or billing being off all render a blank grey panel and throw nothing, so that
# "painted" assertion is the one that catches a misconfigured key.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
