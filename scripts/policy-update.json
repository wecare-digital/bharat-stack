{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Resource": [
                "arn:aws:dynamodb:us-east-1:775261844268:table/base-wecare-digital-*",
                "arn:aws:dynamodb:us-east-1:775261844268:table/MediaFile",
                "arn:aws:dynamodb:us-east-1:775261844268:table/MediaFiles",
                "arn:aws:dynamodb:us-east-1:775261844268:table/SystemConfig",
                "arn:aws:dynamodb:us-east-1:775261844268:table/AIInteractions",
                "arn:aws:dynamodb:us-east-1:775261844268:table/RateLimitTrackers"
            ],
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchWriteItem"
            ]
        },
        {
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::app.wecare.digital",
                "arn:aws:s3:::app.wecare.digital/*",
                "arn:aws:s3:::stream.wecare.digital/*"
            ],
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ]
        },
        {
            "Effect": "Allow",
            "Resource": ["arn:aws:sns:us-east-1:775261844268:base-wecare-digital"],
            "Action": ["sns:Publish"]
        },
        {
            "Effect": "Allow",
            "Resource": ["arn:aws:sqs:us-east-1:775261844268:*"],
            "Action": ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": ["social-messaging:*"]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": ["ses:SendEmail", "ses:SendRawEmail"]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": ["sms-voice:SendTextMessage", "sms-voice:SendVoiceMessage"]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": ["polly:SynthesizeSpeech", "polly:DescribeVoices"]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock-agent-runtime:InvokeAgent",
                "bedrock-agent-runtime:Retrieve",
                "bedrock-agent-runtime:RetrieveAndGenerate"
            ]
        },
        {
            "Effect": "Allow",
            "Resource": "*",
            "Action": ["cloudwatch:PutMetricData"]
        },
        {
            "Effect": "Allow",
            "Resource": ["arn:aws:lambda:us-east-1:775261844268:function:wecare-*"],
            "Action": ["lambda:InvokeFunction"]
        }
    ]
}
