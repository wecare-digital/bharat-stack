@echo off
aws dynamodb scan --table-name stack-wecare-digital-MessagesTable --filter-expression "messageType = :mt1 OR messageType = :mt2" --expression-attribute-values "{\":mt1\":{\"S\":\"payment\"},\":mt2\":{\"S\":\"payment_request\"}}" --projection-expression "id,contactId,senderPhone,messageType,paymentStatus,paymentReferenceId,#s" --expression-attribute-names "{\"#s\":\"status\"}" --limit 50 --output json
